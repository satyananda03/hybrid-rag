# ========================================================================
# Model per peran: model, endpoint, key, timeout (tanpa default bersama)
# ========================================================================
# Extract (ekstraksi entitas/relasi + ringkasan)
EXTRACT_LLM_MODEL=
EXTRACT_LLM_BINDING_HOST=
EXTRACT_LLM_BINDING_API_KEY=
EXTRACT_LLM_TIMEOUT=
EXTRACT_LLM_MAX_ASYNC=2
# Kosong = tanpa batas. Token reasoning ikut dihitung: jangan < 16000 untuk Grok
EXTRACT_LLM_MAX_TOKENS=
# Contextualize (konteks tiap child chunk)
CONTEXTUALIZE_LLM_MODEL=
CONTEXTUALIZE_LLM_BINDING_HOST=
CONTEXTUALIZE_LLM_BINDING_API_KEY=
CONTEXTUALIZE_LLM_TIMEOUT=
# Keyword (kata kunci query, retrieval)
KEYWORD_LLM_MODEL=
KEYWORD_LLM_BINDING_HOST=
KEYWORD_LLM_BINDING_API_KEY=
KEYWORD_LLM_TIMEOUT=
# VLM (caption gambar/tabel)
VLM_MODEL=
VLM_BINDING_HOST=
VLM_BINDING_API_KEY=
VLM_MAX_ASYNC=3
VLM_TIMEOUT=120.0
# Retry panggilan model (diteruskan ke klien oleh providers)
MAX_RETRIES=5

# ========================================================================
# Embedding
# ========================================================================
EMBEDDING_BINDING_HOST=
EMBEDDING_BINDING_API_KEY=
EMBEDDING_MODEL=mjai.titan-embed-text-v2:0
EMBEDDING_DIM=1024
EMBEDDING_TOKEN_LIMIT=8192
EMBEDDING_BATCH_NUM=1
EMBEDDING_FUNC_MAX_ASYNC=8
EMBEDDING_TIMEOUT=60.0

# ========================================================================
# Reranking
# ========================================================================
RERANK_MODEL=
RERANK_BINDING_HOST=
RERANK_BINDING_API_KEY=
RERANK_MAX_ASYNC=4
RERANK_TIMEOUT=30.0
MIN_RERANK_SCORE=0.0
RERANK_BY_DEFAULT=True

# ========================================================================
# Chunking parent-child
# ========================================================================
# Parent = satu section dokumen (heading + isinya); hanya section yang lebih besar dipotong
PARENT_MAX_TOKENS=2048
PARENT_TOP_K=10
CHILD_CHUNK_SIZE=310
CHILD_CHUNK_OVERLAP=50
CONTEXTUALIZE_MAX_ASYNC=10

# ========================================================================
# Ekstraksi knowledge graph
# ========================================================================
MAX_GLEANING=1
FORCE_LLM_SUMMARY_ON_MERGE=8
SUMMARY_MAX_TOKENS=1200
SUMMARY_CONTEXT_SIZE=12000
SUMMARY_LENGTH_RECOMMENDED=1000
SUMMARY_MAX_ASYNC=5
MAX_EXTRACT_INPUT_TOKENS=20480
MAX_SOURCE_IDS_PER_ENTITY=200
MAX_SOURCE_IDS_PER_RELATION=200
SOURCE_IDS_LIMIT_METHOD=KEEP
MAX_FILE_PATHS=80

# ========================================================================
# Multimodal (konteks sekitar gambar/tabel; gambar di bawah ambang FIGURE_MIN_* dibuang oleh semua parser)
# ========================================================================
LEADING_CONTEXT_TOKENS=500
TRAILING_CONTEXT_TOKENS=500
FIGURE_MIN_WIDTH_PX=500
FIGURE_MIN_HEIGHT_PX=500
FIGURE_MIN_AREA_RATIO=0.01

# ========================================================================
# Retrieval
# ========================================================================
TOP_K=10
CHUNK_TOP_K=10
COSINE_THRESHOLD=0.2
MAX_ENTITY_TOKENS=6000
MAX_RELATION_TOKENS=8000
ENABLE_CONTENT_HEADINGS=True
RELATED_CHUNK_NUMBER=5
KG_CHUNK_PICK_METHOD=VECTOR
MAX_GRAPH_NODES=1000
HYBRID_SEARCH_CHUNK_CANDIDATES=30
HYBRID_SEARCH_W_SEMANTIC=1.0
HYBRID_SEARCH_W_KEYWORD=0.8

# ========================================================================
# Konkurensi pipeline & cache
# ========================================================================
MAX_PARALLEL_INGESTION=40
TEXTRACT_MAX_CONCURRENT_JOBS=50
ENABLE_LLM_CACHE=True

# ========================================================================
# PostgreSQL
# ========================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_SCHEMA=rag
POSTGRES_SSL_MODE=prefer
POSTGRES_MAX_CONNECTIONS=25
POSTGRES_VECTOR_INDEX_TYPE=HNSW
POSTGRES_HNSW_M=16
POSTGRES_HNSW_EF=256
POSTGRES_CONNECTION_RETRIES=10
POSTGRES_CONNECTION_RETRY_BACKOFF=3.0
POSTGRES_CONNECTION_RETRY_BACKOFF_MAX=30.0
POSTGRES_POOL_CLOSE_TIMEOUT=5.0
POSTGRES_UPSERT_MAX_PAYLOAD_BYTES=16777216
POSTGRES_UPSERT_MAX_RECORDS_PER_BATCH=200
POSTGRES_DELETE_MAX_RECORDS_PER_BATCH=1000

# ========================================================================
# Neo4j
# ========================================================================
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=
NEO4J_MAX_CONNECTION_POOL_SIZE=100
NEO4J_CONNECTION_TIMEOUT=30.0
NEO4J_CONNECTION_ACQUISITION_TIMEOUT=30.0
NEO4J_MAX_TRANSACTION_RETRY_TIME=30.0
NEO4J_MAX_CONNECTION_LIFETIME=300.0
NEO4J_LIVENESS_CHECK_TIMEOUT=30.0
NEO4J_KEEP_ALIVE=True

# ========================================================================
# S3
# ========================================================================
S3_BUCKET=
S3_PREFIX=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# ========================================================================
# PDF Parser
# ========================================================================
TEXTRACT_ACCESS_KEY_ID=
TEXTRACT_SECRET_ACCESS_KEY=
TEXTRACT_REGION=
TEXTRACT_MODE=async  # async (StartDocumentAnalysis, butuh S3 region yang sama) atau sync (AnalyzeDocument per halaman)

# ========================================================================
# Office → PDF (docx/pptx/doc/odt/rtf dikonversi unoserver, lalu lewat jalur PDF)
# ========================================================================
UNOSERVER_HOST=127.0.0.1
UNOSERVER_PORT=2003
OFFICE_CONVERT_TIMEOUT=120
MAX_PARALLEL_OFFICE_CONVERT=1